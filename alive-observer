#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

if [ -f "$SCRIPT_DIR/.env.local" ]; then
  set -a
  . "$SCRIPT_DIR/.env.local"
  set +a
elif [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

supports_observer_service() {
  candidate="$1"
  [ -x "$candidate" ] || return 1
  "$candidate" -c "import fastapi, uvicorn" >/dev/null 2>&1
}

if [ "${NALR_OBSERVER_PYTHON_BIN:-}" != "" ] && [ -x "${NALR_OBSERVER_PYTHON_BIN}" ]; then
  PYTHON_BIN="${NALR_OBSERVER_PYTHON_BIN}"
elif supports_observer_service "$SCRIPT_DIR/.venv/bin/python"; then
  PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"
elif supports_observer_service "$SCRIPT_DIR/.venv/bin/python3.11"; then
  PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python3.11"
elif supports_observer_service "/opt/homebrew/opt/python@3.11/bin/python3.11"; then
  PYTHON_BIN="/opt/homebrew/opt/python@3.11/bin/python3.11"
else
  PYTHON_BIN="${PYTHON:-python3}"
fi

if [ "${PYTHONPATH:-}" = "" ]; then
  export PYTHONPATH="$SCRIPT_DIR:$SCRIPT_DIR/src"
else
  export PYTHONPATH="$SCRIPT_DIR:$SCRIPT_DIR/src:$PYTHONPATH"
fi

cd "$SCRIPT_DIR"
exec "$PYTHON_BIN" -m nalr.observer_launcher "$@"
